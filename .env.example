# 값을 넣지 말 것. 변수 이름만 유지한다.
POSTGRES_PASSWORD=
DATABASE_URL=
NODE_ENV=

AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_GITHUB_LOGINS=
ENCRYPTION_KEY=

# Caddy 리버스 프록시 뒤에서 실행되므로 true 여야 한다.
# 없으면 Auth.js 가 UntrustedHost 로 모든 인증 요청을 거부한다.
AUTH_TRUST_HOST=

# 공개 URL. Auth.js 가 OAuth 콜백 주소를 만들 때 쓴다.
# 예: https://hub.example.com
AUTH_URL=

HUB_DOMAIN=
ACME_EMAIL=
