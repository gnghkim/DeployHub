{
  "name": "deployhub",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "db:up": "docker compose -f docker/compose.yml up -d postgres",
    "db:down": "docker compose -f docker/compose.yml down"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "happy-dom": "20.11.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
